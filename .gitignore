# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.omc/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local headless-browser profiles used while checking TRPG logs.
/.chrome-trpg-check*/

# env files (can opt-in for committing if needed)
.env*.local

# 로그 비밀번호 원본 (passwords.enc.json 만 커밋할 것)
passwords.json

# TRPG 원본 로그/이미지 (private Trpg-Logs 저장소에서 빌드 시 복사)
/public/images/afterTheRoll/
/public/images/gallery/

# Local directory junction to the sibling private Trpg-Logs repository.
/public/trpg-logs/

# 로컬 뷰 테스트용 임시 캐릭터 이미지
/public/images/characters/test/

# 빌드 시 자동 생성되는 암호화 파일
/public/encrypted/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
